<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_owner_form_inherit_animali" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.animali</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Animali Posseduti">
                    <field name="animal_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="specie_id"/>
                            <field name="razza_id" domain="['|', ('specie_id', '=', False), ('specie_id', '=', specie_id)]"/>
                            <field name="date_of_birth"/>
                            <field name="eta"/>
                            <field name="colore" widget="color"/>
                            <field name="sesso"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>